DATABASE_URL="postgresql://resume:resume@127.0.0.1:5433/resume"
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
APP_URL="http://localhost:3000"
EMAIL_FROM="Resume Builder <login@localhost>"

# Optional. Without EMAIL_SERVER, development shows the magic link on the sign-in page.
# EMAIL_SERVER="smtp://user:pass@smtp.example.com:587"

# Optional OAuth. Buttons appear only when both values are set.
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""
# AUTH_GITHUB_ID=""
# AUTH_GITHUB_SECRET=""

# Optional. Without this key, section rewrites use a local polish pass.
# OPENAI_API_KEY=""

# Optional object storage. Files are always written under data/exports.
# S3-compatible settings also work for Cloudflare R2.
# S3_BUCKET=""
# S3_REGION="auto"
# S3_ENDPOINT="https://accountid.r2.cloudflarestorage.com"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_PUBLIC_URL="https://cdn.example.com"
